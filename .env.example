# 複製成 .env 後填入（.env 已在 .gitignore，不會被 commit）
# 全部留空也能跑，只是會輸出「未經 AI 整理」的降級版。

# Google AI Studio：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq：https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic（選用，付費）：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# LINE 推播（選用）：LINE Developers → 你的 Messaging API channel
#   Basic settings 最下面的「Your user ID」、Messaging API 分頁最下面的「Channel access token」
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
