---
// 一刊的內容：刊頭 → 導讀 → 分類跳轉列 → 台灣／國際／財經／電競，各約 5 則。
// 一刊只有 20 則左右（DECISIONS.md），所以整頁往下滑就看完，不用分頁籤和篩選。
import type { Edition, NewsEvent } from "../types";
import EventCard from "./EventCard.astro";
import Markets from "./Markets.astro";
import { CATEGORIES, editionHref, editionLabel, fmtDate, fmtTime, sortEsports, sortEvents } from "../lib/data";

interface Props {
  edition: Edition;
  prevId?: string | null; // 較舊的一刊
  nextId?: string | null; // 較新的一刊
  isLatest: boolean;
}
const { edition: ed, prevId, nextId, isLatest } = Astro.props;

const focusIds = new Set(ed.headlines);
const dateIso = `${ed.edition_id.slice(0, 10)}T12:00:00+08:00`;
const usage = ed.llm_usage;
const partial = !usage.degraded && ed.events.some((e) => !e.ai_processed);
// 閱讀時間：摘要約每分鐘 400 字，至少 1 分鐘
const chars = ed.events.reduce((n, e) => n + e.title_zh.length + (e.summary_zh?.length ?? 0), 0);
const minutes = Math.max(1, Math.round(chars / 400));

const sections = CATEGORIES.map((c) => {
  const list = ed.events.filter((e) => e.category === c.id);
  const events: NewsEvent[] = c.id === "esports" ? sortEsports(list) : sortEvents(list);
  return { ...c, events };
}).filter((s) => s.events.length > 0 || s.id === "finance");
---

<section class="masthead" data-edition={ed.edition_id}>
  <div class="mast-top">
    <span class="mast-date">{fmtDate(dateIso)}</span>
    <span class="mast-nav">
      {prevId && <a href={editionHref(prevId)}>‹ 上一刊</a>}
      {nextId && <a href={editionHref(nextId)}>下一刊 ›</a>}
    </span>
  </div>
  <h1>
    <span class={`mast-type ${ed.edition_type}`}>{editionLabel(ed.edition_type)}</span>
    <span class="mast-meta">{ed.events.length} 則・約 {minutes} 分鐘</span>
  </h1>
  <div class="mast-sub">
    {fmtTime(ed.published_at)} 出刊・收錄 {fmtTime(ed.window.from)} 之後的新聞
    {usage.degraded && <span class="badge warn">未經 AI 整理</span>}
  </div>

  <div class="read-bar" hidden>
    <div class="read-meter" aria-hidden="true"><span></span></div>
    <div class="read-row">
      <span class="read-progress"></span>
      <button class="text-btn" type="button" data-read-all>全部標為已讀</button>
      <label class="read-hide"><input type="checkbox" data-hide-read /> 隱藏已讀</label>
    </div>
  </div>
</section>

{
  !isLatest && (
    <p class="notice">
      這是過去的一刊。<a href="index.html">看最新一刊 ›</a>
    </p>
  )
}
{
  usage.degraded && (
    <p class="notice">
      這一刊沒有經過 AI 整理（AI 服務暫時無法使用），標題是原文、沒有摘要，重要度依來源數量估算。
    </p>
  )
}
{partial && <p class="notice">部分新聞沒有經過 AI 整理，會標示「未經 AI 整理」。</p>}

{
  ed.briefing.length > 0 && (
    <section class="briefing">
      <h2>導讀</h2>
      <ul>
        {ed.briefing.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </section>
  )
}

<nav class="jump" aria-label="跳到分類">
  {
    sections.map((s) => (
      <a href={`#${s.id}`} class={`jump-link cat-${s.id}`}>
        {s.label}
        <span class="count">{s.events.length}</span>
      </a>
    ))
  }
</nav>

{
  sections.map((s) => (
    <section class={`cat-section cat-${s.id}`} id={s.id}>
      <h2 class="cat-title">
        <span class="cat-dot" aria-hidden="true" />
        {s.label}
        <small>{s.events.length} 則</small>
      </h2>
      {s.id === "finance" && <Markets quotes={ed.markets} />}
      {s.events.length > 0 ? (
        <div class="cards">
          {s.events.map((e) => (
            <EventCard event={e} focus={focusIds.has(e.id)} />
          ))}
        </div>
      ) : (
        <p class="empty">這一刊沒有這個分類的新聞</p>
      )}
    </section>
  ))
}

<nav class="edition-nav" aria-label="切換刊別">
  {prevId ? <a class="nav-btn" href={editionHref(prevId)}>‹ 上一刊</a> : <span></span>}
  <a class="nav-btn ghost" href="archive.html">所有存檔</a>
  {nextId ? <a class="nav-btn" href={editionHref(nextId)}>下一刊 ›</a> : <span></span>}
</nav>

<details class="production">
  <summary>這一刊的製作資訊</summary>
  <p>
    {ed.events.length} 則新聞，來自 {new Set(ed.events.flatMap((e) => e.sources.map((s) => s.name))).size} 個媒體。
    {
      usage.degraded
        ? "未使用 AI。"
        : `AI：${usage.breakdown.map((b) => `${b.provider}（${b.model}）${b.calls} 次`).join("、")}。`
    }
    {ed.source_errors.length > 0 && `${ed.source_errors.length} 個來源抓取失敗：${ed.source_errors.map((s) => s.source_id).join("、")}。`}
  </p>
</details>
