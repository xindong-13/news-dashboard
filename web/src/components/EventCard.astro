---
import type { NewsEvent } from "../types";
import { ESPORTS_TAG_LABELS, LEAGUE_LABELS, SUBCATEGORY_LABELS, fmtDateTime } from "../lib/data";

interface Props {
  event: NewsEvent;
  focus?: boolean; // 這一刊的焦點（edition.headlines）
}
const { event: e, focus = false } = Astro.props;

const sub = e.subcategory && e.subcategory !== "other" ? SUBCATEGORY_LABELS[e.subcategory] : null;
const isLol = e.category === "esports" && e.subcategory === "lol";
const league = isLol && e.league && e.league !== "other" ? LEAGUE_LABELS[e.league] : null;
const tags = e.esports_tags.filter((t) => t !== "other").map((t) => ESPORTS_TAG_LABELS[t]);
// 原文是外文（英、韓…）時才顯示原標題；中文來源的原標題跟翻好的標題差不多，不用再列一次
const showOrig =
  e.original_title &&
  e.ai_processed &&
  e.original_title !== e.title_zh &&
  !(e.sources[0]?.language ?? "").startsWith("zh");
const first = e.sources[0];
// 有些 Google 新聞的來源名稱是網址（例如 https://www.asportstv.kr/），只顯示網域
const label = (name: string) => name.replace(/https?:\/\/(?:www\.)?([^/\s（]+)\/?/, "$1");
const names = [...new Set(e.sources.map((s) => label(s.name)))];
---

<article class:list={["card", { focus }]} data-imp={e.importance} data-eid={e.id}>
  <div class="card-top">
    {focus && <span class="focus-label">焦點</span>}
    {league && <span class="tag league">{league}</span>}
    {sub && !league && <span class="tag">{sub}</span>}
    {tags.map((t) => <span class="tag">{t}</span>)}
    {!e.ai_processed && <span class="badge warn">未經 AI 整理</span>}
    {e.published_at && (
      <time datetime={e.published_at} data-rel>
        {fmtDateTime(e.published_at)}
      </time>
    )}
  </div>
  <h3>{e.title_zh}</h3>
  {showOrig && <p class="orig" lang="">{e.original_title}</p>}
  {e.summary_zh && <p class="summary">{e.summary_zh}</p>}
  {e.why_it_matters && focus && <p class="why">{e.why_it_matters}</p>}
  <div class="card-foot">
    {
      e.sources.length === 1 && first ? (
        <div class="sources">
          <a href={first.url} target="_blank" rel="noopener noreferrer">
            {label(first.name)} ↗
          </a>
        </div>
      ) : (
        <details class="sources">
          <summary>
            {names.slice(0, 2).join("、")}
            {names.length > 2 ? ` 等 ${e.sources.length} 個來源` : ` ${e.sources.length} 個來源`}
          </summary>
          <ul>
            {e.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {label(s.name)} ↗
                </a>
                {s.published_at && (
                  <time class="src-time" datetime={s.published_at} data-rel>
                    {fmtDateTime(s.published_at)}
                  </time>
                )}
              </li>
            ))}
          </ul>
        </details>
      )
    }
    <button class="read-btn" type="button" aria-pressed="false" title="標為已讀">
      <span class="read-off">標為已讀</span><span class="read-on">✓ 已讀</span>
    </button>
  </div>
</article>
